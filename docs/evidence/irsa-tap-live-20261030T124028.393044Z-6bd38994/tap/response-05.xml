<?xml version="1.0" encoding="utf-8"?>
<VOTABLE version="1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.ivoa.net/xml/VOTable/v1.3" xmlns:stc="http://www.ivoa.net/xml/STC/v1.30" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.3 http://www.ivoa.net/xml/VOTable/v1.3 http://www.ivoa.net/xml/STC/v1.30 http://www.ivoa.net/xml/STC/v1.30">
  <RESOURCE type="results">
    <INFO name="QUERY_STATUS" value="OK"/>
    <TABLE>
      <FIELD name="obs_id" datatype="char" arraysize="*" ID="col_0" utype="caom2:Observation.observationID">
        <DESCRIPTION>unique observation identifier (human readable)</DESCRIPTION>
      </FIELD>
      <FIELD name="obs_collection" datatype="char" arraysize="*" ID="col_1" utype="caom2:Observation.collection">
        <DESCRIPTION>data collection this observation belongs to</DESCRIPTION>
      </FIELD>
      <FIELD name="energy_bandpassname" datatype="char" arraysize="*" ID="col_2" utype="caom2:Plane.energy.bandpassName">
        <DESCRIPTION>collection-specific name for energy band (e.g. filter name)</DESCRIPTION>
      </FIELD>
      <FIELD name="t_min" datatype="double" ID="col_3" irsa_format="12.6f" precision="F6" unit="d" utype="caom2:Plane.time.bounds.lower">
        <DESCRIPTION>lower bound on time axis (Modified Julian Day)</DESCRIPTION>
      </FIELD>
      <FIELD name="t_max" datatype="double" ID="col_4" irsa_format="12.6f" precision="F6" unit="d" utype="caom2:Plane.time.bounds.upper">
        <DESCRIPTION>upper bound on time axis (Modified Julian Day)</DESCRIPTION>
      </FIELD>
      <FIELD name="s_region" datatype="char" arraysize="*" ID="col_5" unit="deg">
        <DESCRIPTION>IRSA internal spatial index descriptor</DESCRIPTION>
      </FIELD>
      <FIELD name="s_ra" datatype="double" ID="col_6"/>
      <FIELD name="s_dec" datatype="double" ID="col_7"/>
      <FIELD name="em_min" datatype="double" ID="col_8" irsa_format="10.5e" precision="E5" unit="m" utype="caom2:Plane.energy.bounds.lower">
        <DESCRIPTION>lower bound on energy axis (barycentric wavelength)</DESCRIPTION>
      </FIELD>
      <FIELD name="em_max" datatype="double" ID="col_9" irsa_format="10.5e" precision="E5" unit="m" utype="caom2:Plane.energy.bounds.upper">

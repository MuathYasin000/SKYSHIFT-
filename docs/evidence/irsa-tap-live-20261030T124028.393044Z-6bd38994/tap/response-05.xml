      </FIELD>
      <FIELD name="product_uri" datatype="char" arraysize="*" ID="col_13" utype="caom2:Artifact.uri">
        <DESCRIPTION>artifact access url</DESCRIPTION>
      </FIELD>
      <FIELD name="archive_checksum" datatype="char" arraysize="*" ID="col_14" utype="caom2:Artifact.contentChecksum">
        <DESCRIPTION>checksum of the content (URI of the form {algorithm}:{hex value})</DESCRIPTION>
      </FIELD>
      <DATA>
        <TABLEDATA>
        </TABLEDATA>
      </DATA>
